# Copy this file to an untracked private location and replace placeholders.
# Never commit the populated file.

INTERNAL_OPENAI_BASE_URL=https://judge.example.invalid/v1
INTERNAL_OPENAI_API_KEY=REPLACE_WITH_RUNTIME_SECRET
INTERNAL_OPENAI_MODEL=REPLACE_WITH_VISION_MODEL
INTERNAL_OPENAI_VERIFY_SSL=1

JUDGE_BASE_URL=${INTERNAL_OPENAI_BASE_URL}
JUDGE_MODEL=${INTERNAL_OPENAI_MODEL}

# Process-judge behavior
IOU_PROCESS_USE_VISION=1
IOU_PROCESS_MAX_IMAGES=1
IOU_PROCESS_IMAGE_DETAIL=auto
IOU_PROCESS_PROMPT_VARIANT=v1_multidim_text
IOU_PROCESS_GPT_TIMEOUT_S=60
IOU_PROCESS_GPT_MAX_RETRIES=2

# Answer-judge behavior
QA_ACC_GPT_TIMEOUT_S=30
QA_ACC_GPT_MAX_RETRIES=3

