# Paths are relative to the package root and resolved by scripts/run_rl.sh.
MINIO3_ROOT=third_party/Mini-o3
MODEL_PATH=models/checkpoints/sft_start
TRAIN_JSON=data/mydata/train_final/train1000_v1.json
VAL_JSON=data/mydata/qa_process/val_mini_acc.json
BASE_IMAGE_DIR=data/mydata
OUTPUT_ROOT=outputs/rl

# Runtime
N_GPUS=8
CUDA_VISIBLE_DEVICES=0,1,2,3,4,5,6,7
USE_REMOVE_PADDING=False
VLLM_USE_V1=1

# GRPO batch and optimization
TRAIN_BATCH_SIZE=48
ROLLOUT_N=8
PPO_MINI_BATCH_SIZE=8
PPO_MICRO_BATCH_SIZE_PER_GPU=1
REF_LOG_PROB_MICRO_BATCH_SIZE_PER_GPU=1
ROLLOUT_LOG_PROB_MICRO_BATCH_SIZE_PER_GPU=1
ACTOR_LR=5e-7
TOTAL_EPOCHS=5

# Multimodal rollout
MAX_GENERATION_ROUND=6
MAX_PROMPT_LENGTH=8192
MAX_RESPONSE_LENGTH=8192
MAX_NUM_BATCHED_TOKENS=32768
VLLM_INFER_BATCH_SIZE=16
GPU_MEMORY_UTILIZATION=0.62
ROLLOUT_TEMPERATURE=1.0
ROLLOUT_TOP_P=1.0
MAX_PIXELS=1000000
MIN_PIXELS=40000

# Reward
# Use "process" for answer-gated process optimization.
# Use "acc" for the matched answer-only optimization control.
QA_PROCESS_TOTAL_MODE=process
PROCESS_REWARD_WEIGHT=1.0
GPT_THREADS=24

# Checkpoint and validation cadence
SAVE_FREQ=23
TEST_FREQ=6

